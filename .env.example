# =============================================================
#   LEALTIX BACKEND - Plantilla de Variables de Entorno
#   Archivo: .env  (copia este archivo y renombralo a .env)
#   IMPORTANTE: NUNCA subir el .env real a Git
# =============================================================

# ─────────────────────────────────────────────
# BASE DE DATOS (PostgreSQL - Neon / Cloud)
# ─────────────────────────────────────────────
# En Neon (https://console.neon.tech):
# Copia la "Connection String" y asegúrate de que tenga ?sslmode=require
# Ejemplo JDBC:
#   DB_URL=jdbc:postgresql://ep-silent-hill-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# O usa las credenciales por separado:
DB_URL=jdbc:postgresql://ep-xxxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_USER=tu_usuario_de_neon
DB_PASSWORD=tu_password_de_neon

# Configuración del Connection Pool (Hikari) para servidor compartido
DB_POOL_MAX=5
DB_POOL_MIN=2

# ─────────────────────────────────────────────
# CORS / DOMINIOS PERMITIDOS
# ─────────────────────────────────────────────
# Lista separada por comas de orígenes permitidos
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201,https://admin.lealtix.com.mx,https://lealtix.com.mx,https://www.lealtix.com.mx


# ─────────────────────────────────────────────
# STRIPE
# ─────────────────────────────────────────────
# Clave secreta (Secret Key) — NUNCA la pk_, siempre la sk_!
# Recuperala en: https://dashboard.stripe.com/apikeys
# TEST:  sk_test_51...
# LIVE:  sk_live_51...
STRIPE_API_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Webhook Signing Secret
# Recuperalo en: https://dashboard.stripe.com/webhooks -> tu endpoint -> Signing secret
# Formato: whsec_...
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─────────────────────────────────────────────
# SENDGRID
# ─────────────────────────────────────────────
# Recuperala en: https://app.sendgrid.com/settings/api_keys -> Create API Key
# Formato: SG.XXXXXX.XXXXXXXXX
SENDGRID_API_KEY=SG.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────
# Genera una nueva con: openssl rand -base64 64
JWT_SECRET=tu_clave_secreta_jwt_muy_larga_y_segura_de_al_menos_256_bits_aqui

# ─────────────────────────────────────────────
# CLOUDINARY
# ─────────────────────────────────────────────
# Recuperalo en: https://console.cloudinary.com -> Dashboard
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key_numerica
CLOUDINARY_SECRET=tu_api_secret
CLOUDINARY_URL=cloudinary://TU_API_KEY:TU_API_SECRET@TU_CLOUD_NAME
