# Backup of application-campaign-dev.properties
# Created: 2026-02-06
# This is a backup. The application-campaign-dev.properties file was intentionally removed from the active resources
# because its values are already present in application.properties.

# Original contents follow:

# Development Profile for Campaign Email System
# Use this file to override default properties locally

# Campaign Email Configuration (Development)
# Scheduler runs every 30 seconds, processes 50 emails per batch
campaign.email.scheduler.interval=30000
campaign.email.batch.size=50
campaign.email.provider.name=sendgrid
campaign.email.max.attempts=3

# Logging levels for campaign email system
logging.level.com.lealtixservice.service.CampaignEmailScheduler=INFO
logging.level.com.lealtixservice.service.CampaignEmailSender=INFO
logging.level.com.lealtixservice.service.CampaignEmailOrchestrator=INFO

# Enable detailed SQL logging (optional)
# logging.level.org.hibernate.SQL=DEBUG
# logging.level.org.hibernate.type.descriptor.sql.BasicBinder=TRACE
